{
  "expo": {
    "name": "Hermione POC",
    "slug": "hermione-poc",
    "scheme": "hermione-poc",
    "version": "0.1.1",
    "updates": { "enabled": false },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F0E6",
    "android": {
      "package": "com.example.hermione.poc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "versionCode": 2,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/with-high-refresh-rate",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes uses the microphone to turn your speech into text.",
          "speechRecognitionPermission": "Hermes turns your speech into text on this phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos to send to your bot.",
          "cameraPermission": "Take a photo to send to your bot."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4438"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-hermione.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F0E6",
          "dark": {
            "image": "./assets/splash-hermione-dark.png",
            "backgroundColor": "#141413"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
